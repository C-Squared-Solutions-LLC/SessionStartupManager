<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>ClaudeStartupManager</AssemblyName>
    <RootNamespace>ClaudeStartupManager</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Company>C-Squared Solutions LLC</Company>
    <Product>Claude Startup Manager</Product>
    <Copyright>Copyright (c) 2026 C-Squared Solutions LLC</Copyright>
  </PropertyGroup>

</Project>
